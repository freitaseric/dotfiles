{
	"layer": "top",
	"position": "top",
	"height": 30,

	"margin-top": 4,
	"margin-left": 4,
	"margin-right": 4,

	"modules-left": [
		"hyprland/workspaces"
	],

	"modules-center": [
		"hyprland/window"
	],

	"modules-right":  [
		"network",
		"pulseaudio",
		"clock"
	],

	"hyprland/workspaces": {
		"disable-scroll": true,
		"sort-by-number": true,
		"format": "{name}",

		"persistent-workspaces": {
			"1": [],
			"2": [],
			"3": [],
			"4": [],
			"5": []
		}
	},

	"hyprland/window": {
		"format": "{}",
		"max-length": 38,

		"rewrite": {
			"(.*) — Mozilla Firefox": "$1",
			"(.*) - Mozilla Firefox": "$1",
			"(.*) — Firefox": "$1",

			"(.*) - Visual Studio Code": "$1",
			"(.*) — Visual Studio Code": "$1",

			"(.*) - VSCodium": "$1",
			"(.*) — VSCodium": "$1"
		}
	},

	"network": {
		"format-wifi": "",
		"format-ethernet": "󰈀",
		"format-disconnected": "󰖪",
		"tooltip-format-wifi": "{essid}\nSinal: {signalStrength}%",
		"tooltip-format-ethernet": "{ifname}\n{ipaddr}",
		"on-click": "nm-connection-editor"
	},

	"pulseaudio": {
		"format": "{icon}",
		"format-muted": "󰖁",
		"format-icons": {
			"default": ["", "", ""]
		},
		"tooltip-format": "Volume: {volume}%",
		"scroll-step": 5,
		"on-click": "pavucontrol"
	},

	"clock": {
		"format": "{:%H:%M}",
		"format-alt": "{:%d/%m/%Y %H:%M}"
	}
}
